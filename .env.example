# URL da API, nao a URL do painel web. Sem /alerts/ ao final.
TACTICAL_BASE_URL=SUA URL AQUI
TACTICAL_API_KEY=SUA API KEY AQUI 
# Se usar CA corporativa, informe o caminho do certificado PEM. Nunca desative TLS.
TACTICAL_CA_FILE=
# GLPI/TurboDesk: URL da API (normalmente termina em /apirest.php), sem /Ticket/.
GLPI_BASE_URL=https://glpi.exemplo.com/apirest.php
GLPI_USER_TOKEN=SUA_CHAVE_DE_USUARIO
# Opcional na API V1; deixe vazio se sua instalação não fornecer um.
GLPI_APP_TOKEN=
GLPI_OPEN_STATUSES=1,2,3,4
GLPI_CA_FILE=
# Somente para GLPI sem HTTPS. Tokens trafegam em texto claro; prefira VPN/rede confiavel.
GLPI_ALLOW_INSECURE_HTTP=false

# URL completa da API JSON-RPC e token de leitura do Zabbix.
ZABBIX_API_URL=http://monitor.suaempresa.com.br:8989/api_jsonrpc.php
ZABBIX_API_TOKEN=SUA_CHAVE_AQUI
ZABBIX_CA_FILE=
# Somente se essa instancia Zabbix usar HTTP.
ZABBIX_ALLOW_INSECURE_HTTP=true

# Grafana 12.1: instancias diferentes, tokens de leitura potencialmente diferentes.
GRAFANA_MONITOR_BASE_URL=http://monitor.suaempresa.com.br:3099
GRAFANA_MONITOR_SERVICE_TOKEN=SUA_CHAVE_AQUI
GRAFANA_MONITOR_CA_FILE=
GRAFANA_MONITOR_ALLOW_INSECURE_HTTP=true

GRAFANA_HELPDESK_BASE_URL=http://helpdesk.suaempresa.com.br:3089
GRAFANA_HELPDESK_SERVICE_TOKEN=SUA_CHAVE_AQUI
GRAFANA_HELPDESK_CA_FILE=
GRAFANA_HELPDESK_ALLOW_INSECURE_HTTP=true
